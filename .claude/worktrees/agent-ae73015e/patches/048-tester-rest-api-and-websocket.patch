@@ -0,0 +1,88 @@
+import { Router } from 'express';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { getActiveTesterRuns, getTesterRunState, abortTesterPipeline, continueTesterPipeline } from '../tester-mode.js';
+
+const router = Router();
+
+/**
+ * GET /api/tester/runs
+ * List active tester runs (in-memory).
+ */
+router.get('/runs', (_req, res) => {
+  res.json({ runs: getActiveTesterRuns() });
+});
+
+/**
+ * GET /api/tester/runs/:testerId
+ * Get single tester run state.
+ */
+router.get('/runs/:testerId', async (req, res) => {
+  const { testerId } = req.params;
+
+  // Try in-memory first
+  const activeRecord = getTesterRunState(testerId);
+  if (activeRecord) {
+    res.json(activeRecord);
+    return;
+  }
+
+  // Fall back to file-based state (for orchestrator polling)
+  const projectPath = req.query.project || process.cwd();
+  const statePath = path.join(String(projectPath), '.cloudcli/tester-runs', `${testerId.replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 200)}.json`);
+  try {
+    const raw = await fs.readFile(statePath, 'utf8');
+    res.json(JSON.parse(raw));
+  } catch {
+    res.status(404).json({ error: 'Tester run not found' });
+  }
+});
+
+/**
+ * POST /api/tester/runs/:testerId/continue
+ * Continue a paused/waiting tester pipeline (called by orchestrator).
+ */
+router.post('/runs/:testerId/continue', async (req, res) => {
+  const { testerId } = req.params;
+  const projectPath = req.body?.projectPath || req.query.project || process.cwd();
+  const provider = req.body?.provider || 'claude';
+
+  // Create a minimal writer that discards output (orchestrator doesn't need it)
+  const nullWriter = {
+    send: () => {},
+    isWebSocketWriter: true,
+  };
+
+  try {
+    // Fire-and-forget: don't wait for the full session to complete
+    continueTesterPipeline(testerId, {
+      projectPath: String(projectPath),
+      cwd: String(projectPath),
+    }, nullWriter, String(provider))
+      .catch((err) => {
+        console.error(`[tester] Continue failed for ${testerId}:`, err instanceof Error ? err.message : String(err));
+      });
+
+    res.json({ success: true, testerId });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    res.status(500).json({ error: message });
+  }
+});
+
+/**
+ * POST /api/tester/runs/:testerId/abort
+ * Abort a running tester pipeline.
+ */
+router.post('/runs/:testerId/abort', async (req, res) => {
+  const { testerId } = req.params;
+  try {
+    const success = await abortTesterPipeline(testerId);
+    res.json({ success });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    res.status(500).json({ error: message });
+  }
+});
+
+export default router;
