+// ---------------------------
+//----------------- PROVIDER SKILL DISCOVERY UTILITIES ------------
+export async function findProviderSkillMarkdownFiles(
+  rootDir: string,
+  options?: { recursive?: boolean },
+): Promise<string[]> {
+  const results: string[] = [];
+
+  try {
+    if (options?.recursive) {
+      await walkForSkillFiles(rootDir, results);
+    } else {
+      const entries = await readdir(rootDir, { withFileTypes: true });
+      for (const entry of entries) {
+        if (!entry.isDirectory()) {
+          continue;
+        }
+        const skillPath = path.join(rootDir, entry.name, 'SKILL.md');
+        try {
+          await access(skillPath);
+          results.push(skillPath);
+        } catch {
+          // No SKILL.md in this subdirectory.
+        }
+      }
+    }
+  } catch {
+    // Missing or unreadable directories return empty.
+  }
+
+  return results.sort();
+}
+
+async function walkForSkillFiles(dir: string, results: string[]): Promise<void> {
+  try {
+    const entries = await readdir(dir, { withFileTypes: true });
+    for (const entry of entries) {
+      const fullPath = path.join(dir, entry.name);
+      if (entry.isDirectory()) {
+        await walkForSkillFiles(fullPath, results);
+      } else if (entry.isFile() && entry.name === 'SKILL.md') {
+        results.push(fullPath);
+      }
+    }
+  } catch {
+    // Unreadable directory — skip.
+  }
+}
+
+export async function readProviderSkillMarkdownDefinition(
+  skillPath: string,
+): Promise<{ name: string; description: string }> {
+  const content = await readFile(skillPath, 'utf8');
+  const parsed = parseFrontMatter(content);
+  const data = readObjectRecord(parsed.data) ?? {};
+
+  return {
+    name: readOptionalString(data.name) ?? path.basename(path.dirname(skillPath)),
+    description: readOptionalString(data.description) ?? '',
+  };
+}
+
+export function addUniqueProviderSkillSource(
+  sources: ProviderSkillSource[],
+  seenRootDirs: Set<string>,
+  source: ProviderSkillSource,
+): void {
+  const resolved = path.resolve(source.rootDir);
+  if (seenRootDirs.has(resolved)) {
+    return;
+  }
+  seenRootDirs.add(resolved);
+  sources.push(source);
+}
+
+export async function findTopmostGitRoot(startDir: string): Promise<string | null> {
+  let topmost: string | null = null;
+  let current = path.resolve(startDir);
+
+  while (true) {
+    try {
+      await access(path.join(current, '.git'));
+      topmost = current;
+    } catch {
+      // No .git here.
+    }
+
+    const parent = path.dirname(current);
+    if (parent === current) {
+      break;
+    }
+    current = parent;
+  }
+
+  return topmost;
+}
