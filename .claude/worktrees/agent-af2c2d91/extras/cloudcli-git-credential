#!/bin/bash
# Git credential helper: reads the active token from CloudCLI's SQLite DB.
#
# Multi-host support: works for any git host (GitHub, Gitea, GitLab, etc.)
# that has tokens stored in the user_credentials table with a matching git_host.
#
# Behavior:
#   1) If stdin contains `username=<name>` (because a repo has
#      `credential.<remote>.username=<name>` set — done via `cloudcli-project token`),
#      look up a CloudCLI token with credential_name=<name> for the request's host.
#   2) Otherwise, fall back to the single `is_active=1` token for that host
#      (the "global" token set from Settings → API & Tokens).
#
# Wired globally at /etc/gitconfig so CloudCLI's UI (which writes ~/.gitconfig)
# cannot clobber it.
set -u

action="${1:-}"
[ "$action" = "get" ] || exit 0

host=""
proto=""
username=""
while IFS= read -r line; do
	[ -z "$line" ] && break
	key="${line%%=*}"
	val="${line#*=}"
	case "$key" in
		host)     host="$val" ;;
		protocol) proto="$val" ;;
		username) username="$val" ;;
	esac
done

# Only answer for HTTPS
[ "$proto" = "https" ] || exit 0
# Must have a host
[ -n "$host" ] || exit 0

DB=/home/node/.cloudcli/auth.db
[ -r "$DB" ] || exit 0

sql_quote() {
	# escape single quotes for SQLite: ' -> ''
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

token=""
git_username=""

# 1) Per-repo routing: caller provided a username that maps to a named token
if [ -n "$username" ]; then
	row=$(sqlite3 -noheader -separator '|' -batch "$DB" \
		"SELECT credential_value, git_username FROM user_credentials
		 WHERE git_host=$(sql_quote "$host")
		   AND credential_name=$(sql_quote "$username")
		 ORDER BY is_active DESC, created_at DESC
		 LIMIT 1;" 2>/dev/null)
	token="${row%%|*}"
	git_username="${row#*|}"
	# If no match by host, try without host filter (backward compat for old tokens without git_host)
	if [ -z "$token" ]; then
		row=$(sqlite3 -noheader -separator '|' -batch "$DB" \
			"SELECT credential_value, git_username FROM user_credentials
			 WHERE credential_name=$(sql_quote "$username")
			   AND (git_host IS NULL OR git_host = '' OR git_host=$(sql_quote "$host"))
			 ORDER BY is_active DESC, created_at DESC
			 LIMIT 1;" 2>/dev/null)
		token="${row%%|*}"
		git_username="${row#*|}"
	fi
fi

# 2) Fallback: active global token for this host
if [ -z "$token" ]; then
	row=$(sqlite3 -noheader -separator '|' -batch "$DB" \
		"SELECT credential_value, git_username FROM user_credentials
		 WHERE git_host=$(sql_quote "$host")
		   AND is_active=1
		 ORDER BY created_at DESC
		 LIMIT 1;" 2>/dev/null)
	token="${row%%|*}"
	git_username="${row#*|}"
fi

# 3) Legacy fallback: if host is github.com, also check old tokens without git_host set
if [ -z "$token" ] && [ "$host" = "github.com" ]; then
	row=$(sqlite3 -noheader -separator '|' -batch "$DB" \
		"SELECT credential_value, git_username FROM user_credentials
		 WHERE credential_type='github_token'
		   AND (git_host IS NULL OR git_host = '' OR git_host='github.com')
		   AND is_active=1
		 ORDER BY created_at DESC
		 LIMIT 1;" 2>/dev/null)
	token="${row%%|*}"
	git_username="${row#*|}"
fi

[ -z "$token" ] && exit 0

# Determine the username to send back:
#   - If git_username is set in the DB, use it (Gitea needs the actual username)
#   - If caller provided a username via credential routing, echo it back
#   - Default to x-access-token (works for GitHub PATs)
if [ -n "$git_username" ] && [ "$git_username" != "|" ]; then
	printf 'username=%s\n' "$git_username"
elif [ -n "$username" ]; then
	printf 'username=%s\n' "$username"
else
	printf 'username=%s\n' "x-access-token"
fi
printf 'password=%s\n' "$token"
