+const captureLatestCommit = async (cwd) => {
+  try {
+    const { execFile } = await import('node:child_process');
+    return new Promise((resolve) => {
+      execFile('git', ['log', '-1', '--format=%H|%s'], { cwd }, (err, stdout) => {
+        if (err || !stdout.trim()) {
+          resolve(null);
+          return;
+        }
+        const [sha, ...msgParts] = stdout.trim().split('|');
+        resolve({ sha, message: msgParts.join('|') });
+      });
+    });
+  } catch {
+    return null;
+  }
+};
+
+const appendToCommitLog = async (runState, entry) => {
+  if (!runState?.record) return;
+  if (!Array.isArray(runState.record.commitLog)) {
+    runState.record.commitLog = [];
+  }
+  runState.record.commitLog.push({ ...entry, timestamp: new Date().toISOString() });
+  await persistBuilderRunState(runState);
+};
