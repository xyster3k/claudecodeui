new file mode 100644
index 0000000..34a786c
--- /dev/null
+++ b/src/components/sidebar/view/subcomponents/ActiveTestersPanel.tsx
@@ -0,0 +1,204 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { TestTube2, Square, Play, ChevronDown, ChevronRight } from 'lucide-react';
+
+import { authenticatedFetch } from '../../../../utils/api';
+
+type TesterRun = {
+  testerId: string;
+  mode: string;
+  status: string;
+  currentStage: string;
+  provider: string;
+  sessionCount: number;
+  metrics: {
+    totalBugsFound: number;
+    bugsFixed: number;
+    stagesCompleted: number;
+    stagesTotal: number;
+  };
+  createdAt: string | null;
+  projectPath: string;
+};
+
+const POLL_INTERVAL = 3000;
+
+const STATUS_COLORS: Record<string, string> = {
+  running: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
+  waiting_deploy: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
+  waiting_process: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
+  paused: 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400',
+  completed: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
+  failed: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300',
+};
+
+function elapsed(createdAt: string | null): string {
+  if (!createdAt) return '';
+  const ms = Date.now() - new Date(createdAt).getTime();
+  if (ms < 60_000) return '<1m';
+  const mins = Math.floor(ms / 60_000);
+  if (mins < 60) return `${mins}m`;
+  const hrs = Math.floor(mins / 60);
+  return `${hrs}h ${mins % 60}m`;
+}
+
+function statusLabel(status: string): string {
+  switch (status) {
+    case 'running': return 'running';
+    case 'waiting_deploy': return 'deploying';
+    case 'waiting_process': return 'waiting';
+    case 'paused': return 'paused';
+    case 'completed': return 'done';
+    case 'failed': return 'failed';
+    default: return status;
+  }
+}
+
+export default function ActiveTestersPanel() {
+  const { t } = useTranslation('sidebar');
+  const [runs, setRuns] = useState<TesterRun[]>([]);
+  const [expanded, setExpanded] = useState(true);
+  const [aborting, setAborting] = useState<Set<string>>(new Set());
+  const [continuing, setContinuing] = useState<Set<string>>(new Set());
+  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  const fetchRuns = useCallback(async () => {
+    try {
+      const resp = await authenticatedFetch('/api/tester/runs');
+      if (!resp.ok) return;
+      const data = await resp.json();
+      setRuns(data.runs || []);
+    } catch {
+      // ignore
+    }
+  }, []);
+
+  useEffect(() => {
+    fetchRuns();
+    intervalRef.current = setInterval(fetchRuns, POLL_INTERVAL);
+    return () => {
+      if (intervalRef.current) clearInterval(intervalRef.current);
+    };
+  }, [fetchRuns]);
+
+  const handleAbort = useCallback(async (testerId: string) => {
+    setAborting((prev) => new Set(prev).add(testerId));
+    try {
+      await authenticatedFetch(`/api/tester/runs/${testerId}/abort`, { method: 'POST' });
+      await fetchRuns();
+    } catch {
+      // ignore
+    } finally {
+      setAborting((prev) => {
+        const next = new Set(prev);
+        next.delete(testerId);
+        return next;
+      });
+    }
+  }, [fetchRuns]);
+
+  const handleContinue = useCallback(async (testerId: string) => {
+    setContinuing((prev) => new Set(prev).add(testerId));
+    try {
+      await authenticatedFetch(`/api/tester/runs/${testerId}/continue`, { method: 'POST' });
+      await fetchRuns();
+    } catch {
+      // ignore
+    } finally {
+      setContinuing((prev) => {
+        const next = new Set(prev);
+        next.delete(testerId);
+        return next;
+      });
+    }
+  }, [fetchRuns]);
+
+  if (runs.length === 0) return null;
+
+  const activeRuns = runs.filter((r) => r.status !== 'completed' && r.status !== 'failed');
+  if (activeRuns.length === 0) return null;
+
+  return (
+    <div className="border-b border-border/50 bg-emerald-50/30 dark:bg-emerald-950/10">
+      {/* Header */}
+      <button
+        type="button"
+        className="flex w-full items-center gap-1.5 px-3 py-2 text-xs font-medium text-emerald-700 transition-colors hover:bg-emerald-50/50 dark:text-emerald-400 dark:hover:bg-emerald-950/20"
+        onClick={() => setExpanded((v) => !v)}
+      >
+        {expanded ? (
+          <ChevronDown className="h-3 w-3" />
+        ) : (
+          <ChevronRight className="h-3 w-3" />
+        )}
+        <TestTube2 className="h-3 w-3" />
+        <span>
+          {t('activeTesters.title', { count: activeRuns.length, defaultValue: 'Active Tests ({{count}})' })}
+        </span>
+      </button>
+
+      {/* Run list */}
+      {expanded && (
+        <div className="space-y-1 px-2 pb-2">
+          {activeRuns.map((run) => (
+            <div
+              key={run.testerId}
+              className="flex flex-col gap-1.5 rounded-lg border border-border/40 bg-card/80 px-2.5 py-2"
+            >
+              {/* Stage + status */}
+              <div className="flex items-start justify-between gap-2">
+                <span className="min-w-0 flex-1 truncate text-xs text-foreground">
+                  {run.currentStage || t('activeTesters.untitled', { defaultValue: 'Tester run' })}
+                </span>
+                <span className={`flex-shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium ${STATUS_COLORS[run.status] || STATUS_COLORS.running}`}>
+                  {statusLabel(run.status)}
+                </span>
+              </div>
+
+              {/* Metrics */}
+              <div className="flex items-center gap-2 text-[10px] text-muted-foreground">
+                {run.createdAt && <span>{elapsed(run.createdAt)}</span>}
+                {run.metrics.totalBugsFound > 0 && (
+                  <span>{run.metrics.bugsFixed}/{run.metrics.totalBugsFound} bugs fixed</span>
+                )}
+                <span>S{run.sessionCount}</span>
+                {run.metrics.stagesTotal > 0 && (
+                  <span>{run.metrics.stagesCompleted}/{run.metrics.stagesTotal}</span>
+                )}
+                {run.provider !== 'claude' && (
+                  <span className="rounded bg-muted px-1 py-0.5 uppercase">{run.provider}</span>
+                )}
+              </div>
+
+              {/* Actions */}
+              <div className="flex items-center justify-end gap-1">
+                {(run.status === 'paused' || run.status === 'waiting_process') && (
+                  <button
+                    type="button"
+                    className="flex h-6 items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50 px-2 text-[10px] font-medium text-emerald-700 transition-colors hover:bg-emerald-100 active:scale-95 disabled:opacity-50 dark:border-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400 dark:hover:bg-emerald-900/50"
+                    onClick={() => handleContinue(run.testerId)}
+                    disabled={continuing.has(run.testerId)}
+                    title={t('activeTesters.continue', { defaultValue: 'Continue' })}
+                  >
+                    <Play className="h-2.5 w-2.5 fill-current" />
+                    {t('activeTesters.continue', { defaultValue: 'Continue' })}
+                  </button>
+                )}
+                <button
+                  type="button"
+                  className="flex h-6 items-center gap-1 rounded-md border border-red-200 bg-red-50 px-2 text-[10px] font-medium text-red-700 transition-colors hover:bg-red-100 active:scale-95 disabled:opacity-50 dark:border-red-800 dark:bg-red-900/30 dark:text-red-400 dark:hover:bg-red-900/50"
+                  onClick={() => handleAbort(run.testerId)}
+                  disabled={aborting.has(run.testerId)}
+                  title={t('activeTesters.stop', { defaultValue: 'Stop' })}
+                >
+                  <Square className="h-2.5 w-2.5 fill-current" />
+                  {t('activeTesters.stop', { defaultValue: 'Stop' })}
+                </button>
+              </div>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
