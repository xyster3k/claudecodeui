+type SessionGroup = {
+  parent: SessionWithProvider;
+  children: SessionWithProvider[];
+};
+
+function useSessionGroups(sessions: SessionWithProvider[]) {
+  return useMemo(() => {
+    const childMap = new Map<string, SessionWithProvider[]>();
+    const parentIds = new Set<string>();
+    const standalone: SessionWithProvider[] = [];
+
+    // First pass: identify children (sessions that have a parentSessionId)
+    for (const session of sessions) {
+      if (session.parentSessionId) {
+        const siblings = childMap.get(session.parentSessionId) || [];
+        siblings.push(session);
+        childMap.set(session.parentSessionId, siblings);
+        parentIds.add(session.parentSessionId);
+      }
+    }
+
+    // Second pass: build groups and standalone list
+    const groups: SessionGroup[] = [];
+    const sessionIdSet = new Set(sessions.map(s => s.id));
+    for (const session of sessions) {
+      if (session.parentSessionId) {
+        // If the parent exists in the list, this child will be rendered
+        // inside its group. If the parent is missing (e.g. paginated out),
+        // show the child as a standalone session so it doesn't disappear.
+        if (sessionIdSet.has(session.parentSessionId)) {
+          continue;
+        }
+        standalone.push(session);
+        continue;
+      }
+      if (parentIds.has(session.id)) {
+        groups.push({ parent: session, children: childMap.get(session.id) || [] });
+      } else {
+        standalone.push(session);
+      }
+    }
+
+    return { groups, standalone };
+  }, [sessions]);
+}
