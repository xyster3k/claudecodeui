+            className="absolute right-0 top-0 z-10 h-full w-1 cursor-col-resize border-r border-border/50 hover:border-primary/50 hover:bg-primary/10 active:border-primary active:bg-primary/20"
+            onMouseDown={handleSidebarResizeStart}
           />
         </div>
       ) : (
