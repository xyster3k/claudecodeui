+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Hammer, Square, ChevronDown, ChevronRight } from 'lucide-react';
+
+import { authenticatedFetch } from '../../../../utils/api';
+
+type BuilderRun = {
+  sessionId: string;
+  provider: string;
+  command: string;
+  phase: string;
+  status: string;
+  aborted: boolean;
+  attached: boolean;
+  hasPendingApprovals: boolean;
+  messageCount: number;
+  createdAt: string | null;
+  projectPath: string;
+};
+
+const POLL_INTERVAL = 3000;
+
+const PHASE_COLORS: Record<string, string> = {
+  initializing: 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400',
+  planning: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
+  working: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
+  integrating: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300',
+  qa: 'bg-teal-100 text-teal-700 dark:bg-teal-900/40 dark:text-teal-300',
+  complete: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
+  aborted: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300',
+};
+
+function elapsed(createdAt: string | null): string {
+  if (!createdAt) return '';
+  const ms = Date.now() - new Date(createdAt).getTime();
+  if (ms < 60_000) return '<1m';
+  const mins = Math.floor(ms / 60_000);
+  if (mins < 60) return `${mins}m`;
+  const hrs = Math.floor(mins / 60);
+  return `${hrs}h ${mins % 60}m`;
+}
+
+export default function ActiveBuildsPanel() {
+  const { t } = useTranslation('sidebar');
+  const [runs, setRuns] = useState<BuilderRun[]>([]);
+  const [expanded, setExpanded] = useState(true);
+  const [aborting, setAborting] = useState<Set<string>>(new Set());
+  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  const fetchRuns = useCallback(async () => {
+    try {
+      const resp = await authenticatedFetch('/api/builder/runs');
+      if (!resp.ok) return;
+      const data = await resp.json();
+      setRuns(data.runs || []);
+    } catch {
+      // ignore
+    }
+  }, []);
+
+  useEffect(() => {
+    fetchRuns();
+    intervalRef.current = setInterval(fetchRuns, POLL_INTERVAL);
+    return () => {
+      if (intervalRef.current) clearInterval(intervalRef.current);
+    };
+  }, [fetchRuns]);
+
+  const handleAbort = useCallback(async (sessionId: string) => {
+    setAborting((prev) => new Set(prev).add(sessionId));
+    try {
+      await authenticatedFetch(`/api/builder/runs/${sessionId}/abort`, { method: 'POST' });
+      // Re-fetch immediately so the UI updates
+      await fetchRuns();
+    } catch {
+      // ignore
+    } finally {
+      setAborting((prev) => {
+        const next = new Set(prev);
+        next.delete(sessionId);
+        return next;
+      });
+    }
+  }, [fetchRuns]);
+
+  if (runs.length === 0) return null;
+
+  const activeRuns = runs.filter((r) => r.status === 'running' && !r.aborted);
+  if (activeRuns.length === 0) return null;
+
+  return (
+    <div className="border-b border-border/50 bg-amber-50/30 dark:bg-amber-950/10">
+      {/* Header */}
+      <button
+        type="button"
+        className="flex w-full items-center gap-1.5 px-3 py-2 text-xs font-medium text-amber-700 transition-colors hover:bg-amber-50/50 dark:text-amber-400 dark:hover:bg-amber-950/20"
+        onClick={() => setExpanded((v) => !v)}
+      >
+        {expanded ? (
+          <ChevronDown className="h-3 w-3" />
+        ) : (
+          <ChevronRight className="h-3 w-3" />
+        )}
+        <Hammer className="h-3 w-3" />
+        <span>
+          {t('activeBuilds.title', { count: activeRuns.length, defaultValue: 'Active Builds ({{count}})' })}
+        </span>
+      </button>
+
+      {/* Run list */}
+      {expanded && (
+        <div className="space-y-1 px-2 pb-2">
+          {activeRuns.map((run) => (
+            <div
+              key={run.sessionId}
+              className="flex flex-col gap-1.5 rounded-lg border border-border/40 bg-card/80 px-2.5 py-2"
+            >
+              {/* Command + phase */}
+              <div className="flex items-start justify-between gap-2">
+                <span className="min-w-0 flex-1 truncate text-xs text-foreground" title={run.command}>
+                  {run.command
+                    ? run.command.length > 50
+                      ? run.command.slice(0, 50) + '…'
+                      : run.command
+                    : t('activeBuilds.untitled', { defaultValue: 'Builder run' })}
+                </span>
+                <span className={`flex-shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium ${PHASE_COLORS[run.phase] || PHASE_COLORS.initializing}`}>
+                  {run.phase}
+                </span>
+              </div>
+
+              {/* Meta + actions */}
+              <div className="flex items-center justify-between">
+                <div className="flex items-center gap-2 text-[10px] text-muted-foreground">
+                  {run.createdAt && <span>{elapsed(run.createdAt)}</span>}
+                  {run.provider !== 'claude' && (
+                    <span className="rounded bg-muted px-1 py-0.5 uppercase">{run.provider}</span>
+                  )}
+                </div>
+
+                <div className="flex items-center gap-1">
+                  {/* Stop button */}
+                  <button
+                    type="button"
+                    className="flex h-6 items-center gap-1 rounded-md border border-red-200 bg-red-50 px-2 text-[10px] font-medium text-red-700 transition-colors hover:bg-red-100 active:scale-95 disabled:opacity-50 dark:border-red-800 dark:bg-red-900/30 dark:text-red-400 dark:hover:bg-red-900/50"
+                    onClick={() => handleAbort(run.sessionId)}
+                    disabled={aborting.has(run.sessionId)}
+                    title={t('activeBuilds.stop', { defaultValue: 'Stop build' })}
+                  >
+                    <Square className="h-2.5 w-2.5 fill-current" />
+                    {t('activeBuilds.stop', { defaultValue: 'Stop' })}
+                  </button>
+                </div>
+              </div>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
