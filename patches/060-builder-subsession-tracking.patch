+
+  ensureSessionExists(sessionId: string): void {
+    const db = getConnection();
+    db.prepare(
+      `INSERT OR IGNORE INTO sessions (session_id, provider, project_path, created_at, updated_at)
+       VALUES (?, 'unknown', '', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`
+    ).run(sessionId);
+  },
+
+  setParentSession(sessionId: string, parentSessionId: string): void {
+    const db = getConnection();
+    db.prepare(
+      `UPDATE sessions SET parent_session_id = ? WHERE session_id = ?`
+    ).run(parentSessionId, sessionId);
+  },
+
+  getParentSessionIds(sessionIds: string[]): Map<string, string> {
+    if (!sessionIds.length) return new Map();
+    const db = getConnection();
+    const placeholders = sessionIds.map(() => '?').join(',');
+    const rows = db.prepare(
+      `SELECT session_id, parent_session_id FROM sessions
+       WHERE session_id IN (${placeholders}) AND parent_session_id IS NOT NULL`
+    ).all(...sessionIds) as Array<{ session_id: string; parent_session_id: string }>;
+    return new Map(rows.map(r => [r.session_id, r.parent_session_id]));
+  },
 };
