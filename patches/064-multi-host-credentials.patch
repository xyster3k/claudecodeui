diff --git a/server/modules/database/repositories/gitea-tokens.ts b/server/modules/database/repositories/gitea-tokens.ts
new file mode 100644
index 0000000..8e25fbf
--- /dev/null
+++ b/server/modules/database/repositories/gitea-tokens.ts
@@ -0,0 +1,79 @@
+/**
+ * Gitea tokens repository.
+ *
+ * Helper layer over generic credentials storage for Gitea instances.
+ * Tokens are stored in `user_credentials` with `credential_type = 'gitea_token'`.
+ */
+
+import { credentialsDb } from '@/modules/database/repositories/credentials.js';
+import type {
+  CredentialPublicRow,
+  CreateCredentialResult,
+} from '@/shared/types.js';
+
+const GITEA_TOKEN_TYPE = 'gitea_token';
+const DEFAULT_GITEA_HOST = '';
+const DEFAULT_SSH_HOST = '';
+const DEFAULT_SSH_PORT = '';
+
+export const giteaTokensDb = {
+  /** Creates a Gitea token credential entry. */
+  createGiteaToken(
+    userId: number,
+    tokenName: string,
+    tokenValue: string,
+    giteaUsername: string,
+    description: string | null = null,
+    gitName: string | null = null,
+    gitEmail: string | null = null,
+    gitHost: string = DEFAULT_GITEA_HOST,
+    sshHost: string = DEFAULT_SSH_HOST,
+    sshPort: string = DEFAULT_SSH_PORT
+  ): CreateCredentialResult {
+    return credentialsDb.createCredential(
+      userId,
+      tokenName,
+      GITEA_TOKEN_TYPE,
+      tokenValue,
+      description,
+      gitName,
+      gitEmail,
+      gitHost,
+      giteaUsername,
+      sshHost,
+      sshPort
+    );
+  },
+
+  /** Returns all Gitea tokens (safe shape: no credential value). */
+  getGiteaTokens(userId: number): CredentialPublicRow[] {
+    return credentialsDb.getCredentials(userId, GITEA_TOKEN_TYPE);
+  },
+
+  /** Returns the most recent active Gitea token value for a user. */
+  getActiveGiteaToken(userId: number): string | null {
+    return credentialsDb.getActiveCredential(userId, GITEA_TOKEN_TYPE);
+  },
+
+  /** Returns active Gitea credential for a specific host (including token value). */
+  getActiveGiteaCredentialByHost(
+    userId: number,
+    gitHost: string = DEFAULT_GITEA_HOST
+  ): (CredentialPublicRow & { credential_value: string }) | null {
+    return credentialsDb.getActiveCredentialByHost(userId, gitHost);
+  },
+
+  /** Updates active state for a Gitea token. */
+  updateGiteaToken(
+    userId: number,
+    tokenId: number,
+    isActive: boolean
+  ): boolean {
+    return credentialsDb.toggleCredential(userId, tokenId, isActive);
+  },
+
+  /** Deletes a Gitea token. */
+  deleteGiteaToken(userId: number, tokenId: number): boolean {
+    return credentialsDb.deleteCredential(userId, tokenId);
+  },
+};
