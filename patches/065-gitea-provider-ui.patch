diff --git a/server/routes/gitea.js b/server/routes/gitea.js
new file mode 100644
index 0000000..5b2f164
--- /dev/null
+++ b/server/routes/gitea.js
@@ -0,0 +1,166 @@
+/**
+ * Gitea API proxy routes.
+ *
+ * Proxies requests to a Gitea instance using the user's stored token.
+ * Provides repo browsing, org listing, and repo details.
+ */
+
+import express from 'express';
+import { credentialsDb } from '../modules/database/index.js';
+
+const router = express.Router();
+
+/**
+ * Fetch wrapper for Gitea API calls.
+ * Adds token authentication and returns parsed JSON.
+ */
+async function giteaApiFetch(giteaHost, path, token) {
+  const url = `https://${giteaHost}/api/v1${path}`;
+  const headers = { 'Authorization': `token ${token}`, 'Accept': 'application/json' };
+
+  const response = await fetch(url, { headers, signal: AbortSignal.timeout(15000) });
+  if (!response.ok) {
+    const text = await response.text().catch(() => '');
+    throw new Error(`Gitea API ${response.status}: ${text.slice(0, 200)}`);
+  }
+  return response.json();
+}
+
+/**
+ * GET /api/gitea/repos
+ * List repositories accessible by the user's Gitea token.
+ * Query params: host (default: from active token), q (search), page, limit
+ */
+router.get('/repos', async (req, res) => {
+  try {
+    const { host, q, page = '1', limit = '20' } = req.query;
+
+    // Find the active Gitea credential for this host
+    const credential = findGiteaCredential(req.user.id, host);
+    if (!credential) {
+      return res.status(404).json({ error: 'No active Gitea token found. Add one in Settings → API & Tokens.' });
+    }
+
+    const params = new URLSearchParams({ page, limit, sort: 'updated', order: 'desc' });
+    if (q) params.set('q', q);
+
+    const data = await giteaApiFetch(credential.git_host, `/repos/search?${params}`, credential.credential_value);
+
+    // Sanitize: only return safe fields
+    const repos = (data.data || data || []).map(sanitizeRepo);
+    res.json({ repos, ok: true });
+  } catch (error) {
+    console.error('Gitea repos error:', error);
+    res.status(500).json({ error: error.message });
+  }
+});
+
+/**
+ * GET /api/gitea/repos/:owner/:repo
+ * Get details of a specific repository.
+ */
+router.get('/repos/:owner/:repo', async (req, res) => {
+  try {
+    const { owner, repo } = req.params;
+    const { host } = req.query;
+
+    const credential = findGiteaCredential(req.user.id, host);
+    if (!credential) {
+      return res.status(404).json({ error: 'No active Gitea token found.' });
+    }
+
+    const data = await giteaApiFetch(credential.git_host, `/repos/${owner}/${repo}`, credential.credential_value);
+    res.json({ repo: sanitizeRepo(data), ok: true });
+  } catch (error) {
+    console.error('Gitea repo detail error:', error);
+    res.status(500).json({ error: error.message });
+  }
+});
+
+/**
+ * GET /api/gitea/orgs
+ * List organizations the user belongs to.
+ */
+router.get('/orgs', async (req, res) => {
+  try {
+    const { host } = req.query;
+
+    const credential = findGiteaCredential(req.user.id, host);
+    if (!credential) {
+      return res.status(404).json({ error: 'No active Gitea token found.' });
+    }
+
+    const data = await giteaApiFetch(credential.git_host, '/user/orgs', credential.credential_value);
+    const orgs = (data || []).map((o) => ({
+      id: o.id,
+      name: o.name || o.username,
+      full_name: o.full_name,
+      description: o.description,
+      avatar_url: o.avatar_url,
+    }));
+    res.json({ orgs, ok: true });
+  } catch (error) {
+    console.error('Gitea orgs error:', error);
+    res.status(500).json({ error: error.message });
+  }
+});
+
+/**
+ * GET /api/gitea/hosts
+ * List unique Gitea hosts the user has tokens for.
+ */
+router.get('/hosts', async (req, res) => {
+  try {
+    const credentials = credentialsDb.getCredentials(req.user.id, 'gitea_token');
+    const hosts = [...new Set(credentials.map((c) => c.git_host).filter(Boolean))];
+    res.json({ hosts, ok: true });
+  } catch (error) {
+    console.error('Gitea hosts error:', error);
+    res.status(500).json({ error: error.message });
+  }
+});
+
+// -- helpers --
+
+function findGiteaCredential(userId, host) {
+  let cred = null;
+  if (host) {
+    cred = credentialsDb.getActiveCredentialByHost(userId, host);
+  } else {
+    // No host specified — find any active gitea_token
+    const credentials = credentialsDb.getCredentials(userId, 'gitea_token');
+    const active = credentials.find((c) => c.is_active);
+    if (active) {
+      cred = credentialsDb.getActiveCredentialByHost(userId, active.git_host);
+    }
+  }
+  // Only return if the credential actually has a token (SSH-only hosts have no token)
+  if (cred && (!cred.credential_value || !cred.credential_value.trim())) return null;
+  return cred;
+}
+
+function sanitizeRepo(r) {
+  return {
+    id: r.id,
+    name: r.name,
+    full_name: r.full_name,
+    description: r.description,
+    clone_url: r.clone_url,
+    ssh_url: r.ssh_url,
+    html_url: r.html_url,
+    private: r.private,
+    fork: r.fork,
+    mirror: r.mirror,
+    archived: r.archived,
+    empty: r.empty,
+    default_branch: r.default_branch,
+    language: r.language,
+    size: r.size,
+    stars_count: r.stars_count,
+    forks_count: r.forks_count,
+    updated_at: r.updated_at,
+    owner: r.owner ? { login: r.owner.login || r.owner.username, avatar_url: r.owner.avatar_url } : null,
+  };
+}
+
+export default router;
