diff --git a/src/components/settings/view/tabs/api-settings/sections/GiteaCredentialsSection.tsx b/src/components/settings/view/tabs/api-settings/sections/GiteaCredentialsSection.tsx
new file mode 100644
index 0000000..0dbff5d
--- /dev/null
+++ b/src/components/settings/view/tabs/api-settings/sections/GiteaCredentialsSection.tsx
@@ -0,0 +1,228 @@
+import { Eye, EyeOff, GitBranch, Plus, Trash2 } from 'lucide-react';
+import { Button, Input } from '../../../../../../shared/view/ui';
+import type { GiteaCredentialItem } from '../types';
+
+type GiteaCredentialsSectionProps = {
+  giteaCredentials: GiteaCredentialItem[];
+  showNewGiteaForm: boolean;
+  showNewTokenPlainText: boolean;
+  newGiteaName: string;
+  newGiteaToken: string;
+  newGiteaUsername: string;
+  newGiteaHost: string;
+  newGiteaSshHost: string;
+  newGiteaSshPort: string;
+  newGiteaDescription: string;
+  newGiteaGitName: string;
+  newGiteaGitEmail: string;
+  onShowNewGiteaFormChange: (value: boolean) => void;
+  onNewGiteaNameChange: (value: string) => void;
+  onNewGiteaTokenChange: (value: string) => void;
+  onNewGiteaUsernameChange: (value: string) => void;
+  onNewGiteaHostChange: (value: string) => void;
+  onNewGiteaSshHostChange: (value: string) => void;
+  onNewGiteaSshPortChange: (value: string) => void;
+  onNewGiteaDescriptionChange: (value: string) => void;
+  onNewGiteaGitNameChange: (value: string) => void;
+  onNewGiteaGitEmailChange: (value: string) => void;
+  onToggleNewTokenVisibility: () => void;
+  onCreateGiteaCredential: () => void;
+  onCancelCreateGiteaCredential: () => void;
+  onToggleGiteaCredential: (credentialId: string, isActive: boolean) => void;
+  onDeleteGiteaCredential: (credentialId: string) => void;
+};
+
+export default function GiteaCredentialsSection({
+  giteaCredentials,
+  showNewGiteaForm,
+  showNewTokenPlainText,
+  newGiteaName,
+  newGiteaToken,
+  newGiteaUsername,
+  newGiteaHost,
+  newGiteaSshHost,
+  newGiteaSshPort,
+  newGiteaDescription,
+  newGiteaGitName,
+  newGiteaGitEmail,
+  onShowNewGiteaFormChange,
+  onNewGiteaNameChange,
+  onNewGiteaTokenChange,
+  onNewGiteaUsernameChange,
+  onNewGiteaHostChange,
+  onNewGiteaSshHostChange,
+  onNewGiteaSshPortChange,
+  onNewGiteaDescriptionChange,
+  onNewGiteaGitNameChange,
+  onNewGiteaGitEmailChange,
+  onToggleNewTokenVisibility,
+  onCreateGiteaCredential,
+  onCancelCreateGiteaCredential,
+  onToggleGiteaCredential,
+  onDeleteGiteaCredential,
+}: GiteaCredentialsSectionProps) {
+  return (
+    <div>
+      <div className="mb-4 flex items-center justify-between">
+        <div className="flex items-center gap-2">
+          <GitBranch className="h-5 w-5" />
+          <h3 className="text-lg font-semibold">Gitea Hosts</h3>
+        </div>
+        <Button size="sm" onClick={() => onShowNewGiteaFormChange(!showNewGiteaForm)}>
+          <Plus className="mr-1 h-4 w-4" />
+          Add Gitea Host
+        </Button>
+      </div>
+
+      <p className="mb-4 text-sm text-muted-foreground">
+        Connect to self-hosted Gitea instances. SSH clone works with deploy keys; add a token only if you need HTTPS clone or API repo browsing.
+      </p>
+
+      {showNewGiteaForm && (
+        <div className="mb-4 space-y-3 rounded-lg border bg-card p-4">
+          <Input
+            placeholder="Name (e.g. my-gitea)"
+            value={newGiteaName}
+            onChange={(event) => onNewGiteaNameChange(event.target.value)}
+          />
+
+          <div className="rounded-md border border-dashed bg-muted/30 p-3">
+            <p className="mb-2 text-xs font-medium text-muted-foreground">
+              Host settings (required)
+            </p>
+            <div className="space-y-2">
+              <Input
+                placeholder="HTTPS host (e.g. gitea.example.com)"
+                value={newGiteaHost}
+                onChange={(event) => onNewGiteaHostChange(event.target.value)}
+              />
+              <div className="flex gap-2">
+                <Input
+                  placeholder="SSH host (if different from HTTPS host)"
+                  value={newGiteaSshHost}
+                  onChange={(event) => onNewGiteaSshHostChange(event.target.value)}
+                  className="flex-1"
+                />
+                <Input
+                  placeholder="SSH port"
+                  value={newGiteaSshPort}
+                  onChange={(event) => onNewGiteaSshPortChange(event.target.value)}
+                  className="w-24"
+                />
+              </div>
+            </div>
+          </div>
+
+          <div className="rounded-md border border-dashed bg-muted/30 p-3">
+            <p className="mb-2 text-xs font-medium text-muted-foreground">
+              HTTPS / API access (optional)
+            </p>
+            <p className="mb-3 text-xs text-muted-foreground">
+              Only needed for HTTPS clone or Gitea API repo browsing. SSH clone works without a token.
+            </p>
+            <div className="space-y-2">
+              <Input
+                placeholder="Gitea username"
+                value={newGiteaUsername}
+                onChange={(event) => onNewGiteaUsernameChange(event.target.value)}
+              />
+              <div className="relative">
+                <Input
+                  type={showNewTokenPlainText ? 'text' : 'password'}
+                  placeholder="Personal access token"
+                  value={newGiteaToken}
+                  onChange={(event) => onNewGiteaTokenChange(event.target.value)}
+                  className="pr-10"
+                />
+                <button
+                  type="button"
+                  onClick={onToggleNewTokenVisibility}
+                  aria-label={showNewTokenPlainText ? 'Hide token' : 'Show token'}
+                  className="absolute right-3 top-2.5 text-muted-foreground hover:text-foreground"
+                >
+                  {showNewTokenPlainText ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
+                </button>
+              </div>
+            </div>
+          </div>
+
+          <Input
+            placeholder="Description (optional)"
+            value={newGiteaDescription}
+            onChange={(event) => onNewGiteaDescriptionChange(event.target.value)}
+          />
+
+          <div className="rounded-md border border-dashed bg-muted/30 p-3">
+            <p className="mb-2 text-xs font-medium text-muted-foreground">
+              Per-host git identity (optional)
+            </p>
+            <p className="mb-3 text-xs text-muted-foreground">
+              If set, repos cloned from this host use these as commit author.
+            </p>
+            <div className="space-y-2">
+              <Input
+                placeholder="Git name"
+                value={newGiteaGitName}
+                onChange={(event) => onNewGiteaGitNameChange(event.target.value)}
+              />
+              <Input
+                placeholder="Git email"
+                value={newGiteaGitEmail}
+                onChange={(event) => onNewGiteaGitEmailChange(event.target.value)}
+              />
+            </div>
+          </div>
+
+          <div className="flex gap-2">
+            <Button onClick={onCreateGiteaCredential}>Save</Button>
+            <Button variant="outline" onClick={onCancelCreateGiteaCredential}>
+              Cancel
+            </Button>
+          </div>
+        </div>
+      )}
+
+      <div className="space-y-2">
+        {giteaCredentials.length === 0 ? (
+          <p className="text-sm italic text-muted-foreground">No Gitea hosts configured.</p>
+        ) : (
+          giteaCredentials.map((credential) => (
+            <div key={credential.id} className="flex items-center justify-between rounded-lg border p-3">
+              <div className="flex-1">
+                <div className="font-medium">{credential.credential_name}</div>
+                <div className="text-xs text-muted-foreground">
+                  {credential.git_host}
+                  {credential.ssh_host ? ` | SSH: ${credential.ssh_host}:${credential.ssh_port || '22'}` : ''}
+                  {credential.has_token ? ' | HTTPS token configured' : ' | SSH only'}
+                </div>
+                {credential.description && (
+                  <div className="text-xs text-muted-foreground">{credential.description}</div>
+                )}
+                {(credential.git_name || credential.git_email) && (
+                  <div className="mt-1 text-xs text-muted-foreground">
+                    identity: {credential.git_name || '(inherit)'} &lt;{credential.git_email || '(inherit)'}&gt;
+                  </div>
+                )}
+                <div className="mt-1 text-xs text-muted-foreground">
+                  Added {new Date(credential.created_at).toLocaleDateString()}
+                </div>
+              </div>
+              <div className="flex items-center gap-2">
+                <Button
+                  size="sm"
+                  variant={credential.is_active ? 'outline' : 'secondary'}
+                  onClick={() => onToggleGiteaCredential(credential.id, credential.is_active)}
+                >
+                  {credential.is_active ? 'Active' : 'Inactive'}
+                </Button>
+                <Button size="sm" variant="ghost" onClick={() => onDeleteGiteaCredential(credential.id)}>
+                  <Trash2 className="h-4 w-4" />
+                </Button>
+              </div>
+            </div>
+          ))
+        )}
+      </div>
+    </div>
+  );
+}
