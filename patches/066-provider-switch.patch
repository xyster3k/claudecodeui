+function parseOwnerRepoFromUrl(url: string | null | undefined): { owner: string; repo: string } {
+  if (!url) return { owner: '', repo: '' };
+  // HTTPS: https://host/owner/repo[.git]
+  let m = url.match(/^https?:\/\/[^/]+\/([^/]+)\/(.+?)(?:\.git)?\/?$/);
+  if (m) return { owner: m[1], repo: m[2] };
+  // SSH shorthand: git@host:owner/repo[.git]
+  m = url.match(/^[^@]+@[^:]+:([^/]+)\/(.+?)(?:\.git)?$/);
+  if (m) return { owner: m[1], repo: m[2] };
+  // SSH URI: ssh://git@host[:port]/owner/repo[.git]
+  m = url.match(/^ssh:\/\/[^/]+\/([^/]+)\/(.+?)(?:\.git)?$/);
+  if (m) return { owner: m[1], repo: m[2] };
+  return { owner: '', repo: '' };
