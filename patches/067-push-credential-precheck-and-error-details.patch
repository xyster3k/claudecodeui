+/**
+ * spawnAsync with a timeout (in ms). Kills the child and rejects if it
+ * doesn't finish in time. Used for push/publish to prevent infinite hangs
+ * when SSH connects to a firewalled port that silently drops packets.
+ */
+function spawnAsyncWithTimeout(command, args, options = {}, timeoutMs = 30000) {
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    const timer = setTimeout(() => {
+      if (!settled) {
+        settled = true;
+        try { child.kill('SIGKILL'); } catch (_) {}
+        const err = new Error(`Command timed out after ${timeoutMs / 1000}s: ${command} ${args.join(' ')}`);
+        err.timedOut = true;
+        err.stderr = '';
+        reject(err);
+      }
+    }, timeoutMs);
+
+    const child = spawn(command, args, { ...options, shell: false });
+    // Reuse the same stdout/stderr/close logic as spawnAsync
+    let stdout = '';
+    let stderr = '';
+    child.stdout.on('data', (data) => { stdout += data.toString(); });
+    child.stderr.on('data', (data) => { stderr += data.toString(); });
+    child.on('error', (error) => { if (!settled) { settled = true; clearTimeout(timer); reject(error); } });
+    child.on('close', (code) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      if (code === 0) { resolve({ stdout, stderr }); return; }
+      const error = new Error(`Command failed: ${command} ${args.join(' ')}`);
+      error.code = code;
+      error.stdout = stdout;
+      error.stderr = stderr;
+      reject(error);
+    });
+  });
+}
