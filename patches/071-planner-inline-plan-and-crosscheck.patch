+/**
+ * If `command` looks like a file path (absolute, starts with /, ~, or ./ and ends
+ * with a text-like extension), read the file and return its content prefixed with
+ * provenance metadata.  Otherwise return command unchanged.
+ *
+ * This ensures the planner and coverage reviewer always see the full plan content
+ * inline in the prompt instead of relying on the model to discover and read the file
+ * via tool calls (which some providers do poorly).
+ */
+const resolveCommandContent = async (command, projectPath) => {
+  if (!command || typeof command !== 'string') return command || '';
+  const trimmed = command.trim();
+
+  // Heuristic: looks like a single file path (no newlines, starts with path char,
+  // has a text-like extension).
+  const looksLikePath = /^[~./]/.test(trimmed)
+    && !trimmed.includes('\n')
+    && /\.(md|txt|mdx|rst|org|json|yaml|yml|toml)$/i.test(trimmed);
+
+  if (!looksLikePath) return command;
+
+  // Resolve ~ and relative paths
+  const resolved = trimmed.startsWith('~')
+    ? trimmed.replace(/^~/, process.env.HOME || '/root')
+    : path.isAbsolute(trimmed)
+      ? trimmed
+      : path.resolve(projectPath, trimmed);
+
+  try {
+    const content = await fs.readFile(resolved, 'utf8');
+    return `[Source plan file: ${trimmed}]\n\n${content}`;
+  } catch {
+    // File not readable — pass original command through so the model can try itself
+    return command;
+  }
+};
