+/**
+ * Writes attached base64 images to a temp dir so they can be passed to Codex as
+ * local_image inputs (`codex exec --image`), which sends the pixels to the model.
+ * @param {Array} images - Image objects with `data` as a data URL
+ * @returns {Promise<{imagePaths: Array<string>, tempDir: string|null}>}
+ */
+async function saveCodexImages(images) {
+  const imagePaths = [];
+  if (!Array.isArray(images) || images.length === 0) {
+    return { imagePaths, tempDir: null };
+  }
+
+  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'codex-images-'));
+  for (const [index, image] of images.entries()) {
+    const matches = typeof image?.data === 'string' ? image.data.match(/^data:([^;]+);base64,(.+)$/s) : null;
+    if (!matches) {
+      console.error('[Codex] Invalid image data format');
+      continue;
+    }
+
+    const [, mimeType, base64Data] = matches;
+    const extension = (mimeType.split('/')[1] || 'png').replace('jpeg', 'jpg').replace(/[^a-z0-9]/gi, '');
+    const filepath = path.join(tempDir, `image_${index}.${extension || 'png'}`);
+    await fs.writeFile(filepath, Buffer.from(base64Data, 'base64'));
+    imagePaths.push(filepath);
+  }
+
+  return { imagePaths, tempDir };
+}
