+/**
+ * Interrupts a turn that is still running in this thread and waits for its process to exit,
+ * so a new message can resume the same thread instead of racing a second `codex exec resume`.
+ * @param {string} sessionId - Codex thread ID
+ */
+async function interruptActiveCodexTurn(sessionId) {
+  const entry = activeCodexSessions.get(sessionId);
+  if (!entry) {
+    return;
+  }
+
+  // An already-stopped turn may still be exiting, so wait for it either way
+  if (entry.status === 'running') {
+    console.log(`[Codex] Interrupting running turn in ${sessionId} for a new message`);
+    entry.status = 'aborted';
+    try {
+      entry.abortController?.abort();
+    } catch (error) {
+      console.warn(`[Codex] Failed to interrupt session ${sessionId}:`, error);
+    }
+  }
+  await Promise.race([entry.done, new Promise((resolve) => setTimeout(resolve, 15000))]);
+}
