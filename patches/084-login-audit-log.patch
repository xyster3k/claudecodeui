+// Login audit lines ("[AUTH] ...") are picked up by the LAN deploy's Telegram notifier.
+// Behind Cloudflare Tunnel + Caddy the socket address is the proxy, so prefer the
+// forwarded client address; a direct LAN request has neither header.
+function clientAddress(req) {
+  const forwarded = req.headers['cf-connecting-ip'] || req.headers['x-forwarded-for'];
+  const first = String(forwarded || '').split(',')[0].trim();
+  return first || req.socket?.remoteAddress || 'unknown';
+}
+
+function logLoginAttempt(req, username, outcome) {
+  const via = req.headers['x-forwarded-for'] ? 'proxy' : 'direct';
+  console.log(`[AUTH] login ${outcome} user=${JSON.stringify(String(username || ''))} ip=${clientAddress(req)} via=${via}`);
+}
