new file mode 100644
index 0000000..ffa0339
--- /dev/null
+++ b/server/agy-event-translator.js
@@ -0,0 +1,94 @@
+// Translates Antigravity CLI (`agy -p --output-format stream-json`) NDJSON events into the
+// Gemini CLI stream-json event shapes that GeminiResponseHandler and the Gemini session
+// normalizer already understand. Google retired Gemini CLI for personal accounts
+// (free / AI Pro / Ultra) on 2026-06-18; `agy` is its replacement for those accounts.
+//
+// agy events (verified against agy 1.3.5):
+//   {"event":"init","conversation_id":"…","init":{"model","cwd","tools","permission_mode"}}
+//   {"event":"step_update","step_update":{"step_index","state":"ACTIVE|DONE|…","step_type":
+//       "user_input|agent_response|tool|…","text_delta"?,"tool_name"?,"tool_info"?:{"name",
+//       "parameters","output"?},"usage"?}}
+//   {"event":"result","result":{"conversation_id","status":"SUCCESS|ERROR|…","response",
+//       "error"?,"usage":{"total_tokens",…}}}
+
+const TOOL_FAILURE_STATES = new Set(['ERROR', 'FAILED', 'CANCELED', 'CANCELLED', 'INTERRUPTED']);
+
+export class AgyEventTranslator {
+  constructor() {
+    this.conversationId = null;
+    this.announcedTools = new Set();
+  }
+
+  /**
+   * @param {object} event one parsed agy NDJSON line
+   * @returns {object[]} zero or more Gemini-CLI-shaped events
+   */
+  translate(event) {
+    if (!event || typeof event !== 'object') {
+      return [];
+    }
+
+    if (event.event === 'init') {
+      this.conversationId = event.conversation_id || this.conversationId;
+      return [{ type: 'init', session_id: this.conversationId, model: event.init?.model }];
+    }
+
+    if (event.event === 'step_update') {
+      return this.translateStep(event.step_update || {});
+    }
+
+    if (event.event === 'result') {
+      const result = event.result || {};
+      const out = [];
+      if (result.status && result.status !== 'SUCCESS') {
+        out.push({ type: 'error', error: result.error || `Antigravity run ended with status ${result.status}` });
+      }
+      out.push({
+        type: 'result',
+        status: result.status === 'SUCCESS' ? 'success' : 'error',
+        stats: { total_tokens: result.usage?.total_tokens },
+      });
+      return out;
+    }
+
+    return [];
+  }
+
+  translateStep(step) {
+    if (step.step_type === 'agent_response') {
+      return step.text_delta
+        ? [{ type: 'message', role: 'assistant', content: step.text_delta, delta: true }]
+        : [];
+    }
+
+    if (step.step_type === 'tool') {
+      const toolId = `${step.conversation_id || this.conversationId || 'agy'}:${step.step_index}`;
+      const info = step.tool_info || {};
+      const out = [];
+      if (!this.announcedTools.has(toolId)) {
+        this.announcedTools.add(toolId);
+        out.push({
+          type: 'tool_use',
+          tool_id: toolId,
+          tool_name: info.name || step.tool_name || 'tool',
+          parameters: info.parameters || {},
+        });
+      }
+      const failed = TOOL_FAILURE_STATES.has(step.state);
+      if (step.state === 'DONE' || failed) {
+        let output = info.output;
+        if (output === undefined && info.error !== undefined) output = info.error;
+        if (output !== undefined && typeof output !== 'string') output = JSON.stringify(output);
+        out.push({
+          type: 'tool_result',
+          tool_id: toolId,
+          status: failed ? 'error' : 'success',
+          output: output === undefined ? '' : output.replace(/\r\n/g, '\n'),
+        });
+      }
+      return out;
+    }
+
+    return [];
+  }
+}
