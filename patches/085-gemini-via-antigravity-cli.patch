@@ -44,6 +44,37 @@ type ShellWebSocketDependencies = {
 /**
  * Reads a string field from untyped payloads and falls back when absent.
  */
+const URL_CONTINUATION = /^\r?\n ?([A-Za-z0-9%&=._~:/?#+@!$'()*,;[\]-]+)(?=\r?\n)/;
+
+/**
+ * TUIs such as the Antigravity CLI (`agy`) hard-wrap a long sign-in URL into several
+ * " <chunk>\r\n" lines, so plain URL extraction only finds the first line. Re-join lines
+ * that directly continue a URL (a lone run of URL characters on its own line). Only the
+ * URL-detection copy of the output is changed, never what the terminal displays.
+ */
+function joinHardWrappedUrls(text: string): string {
+  let result = '';
+  let rest = text;
+  for (;;) {
+    const start = rest.search(/https?:\/\//);
+    if (start === -1) {
+      return result + rest;
+    }
+    const lineEnd = rest.slice(start).search(/[\s]/);
+    if (lineEnd === -1) {
+      return result + rest;
+    }
+    let url = rest.slice(start, start + lineEnd);
+    let tail = rest.slice(start + lineEnd);
+    for (let match = URL_CONTINUATION.exec(tail); match; match = URL_CONTINUATION.exec(tail)) {
+      url += match[1];
+      tail = tail.slice(match[0].length);
+    }
+    result += rest.slice(0, start) + url;
+    rest = tail;
+  }
+}
+
 function readString(value: unknown, fallback = ''): string {
   return typeof value === 'string' ? value : fallback;
 }
